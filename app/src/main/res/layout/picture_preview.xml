<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/picture_preview"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:contentDescription="@string/picture"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/picture_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/picture_size"
            android:textSize="12sp" />

        <RadioGroup
            android:id="@+id/picture_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/picture_size_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/picture_size_small" />

            <RadioButton
                android:id="@+id/picture_size_medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/picture_size_medium" />

            <RadioButton
                android:id="@+id/picture_size_large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/picture_size_large" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/picture_robust"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/picture_robust" />

        <CheckBox
            android:id="@+id/picture_encrypt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/picture_encrypt" />
    </LinearLayout>
</ScrollView>
