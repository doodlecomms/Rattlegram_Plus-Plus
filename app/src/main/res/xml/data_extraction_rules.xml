<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
	<!-- The remembered password is encrypted with a key that never leaves this phone; never back it up -->
	<cloud-backup>
		<exclude domain="sharedpref" path="password_store.xml"/>
	</cloud-backup>
	<device-transfer>
		<exclude domain="sharedpref" path="password_store.xml"/>
	</device-transfer>
</data-extraction-rules>